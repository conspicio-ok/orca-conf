{
    "label" : "lock",
    "action" : "gtklock -d",
    "text" : "[ 1 ] Lock",
    "keybind" : "1"
}
{
    "label" : "logout",
    "action" : "swaymsg exit",
    "text" : "[ 4 ] Exit",
    "keybind" : "4"
}
{
    "label" : "shutdown",
    "action" : "poweroff",
    "text" : "[ 2 ] Shutdown",
    "keybind" : "2"
}
{
    "label" : "reboot",
    "action" : "reboot",
    "text" : "[ 5 ] Reboot",
    "keybind" : "5"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "[ 3 ] Hibernate",
    "keybind" : "3"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "[ 6 ] Suspend",
    "keybind" : "6"
}
